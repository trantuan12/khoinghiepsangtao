# ========================================================
# MẪU CẤU HÌNH MÔI TRƯỜNG CHO HỆ THỐNG CARE MATCH (.env.example)
# Khi triển khai lên Cloud / VPS: Copy file này thành .env và điền thông số thật
# ========================================================

# 1. CỔNG CHẠY SERVER BACKEND
PORT=5000
NODE_ENV=production

# 2. CẤU HÌNH KẾT NỐI POSTGRESQL / SUPABASE DATABASE
# Cách 1 (Khuyên dùng với Supabase): Dán trực tiếp Connection String từ Supabase
# Vào Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# (Nếu deploy lên Vercel Serverless, nên dùng Transaction Pooler port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Cách 2 (Nếu không dùng DATABASE_URL thì điền rời từng biến bên dưới):
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_USER=postgres.[PROJECT-REF]
# DB_PASSWORD=your_supabase_password
# DB_NAME=postgres
# DB_SSL=true

# 3. ĐỊA CHỈ TRANG WEB FRONTEND ĐƯỢC PHÉP TRUY CẬP (CORS)
# Local: http://localhost:3000
# Vercel: https://ten-app.vercel.app
CLIENT_URL=http://localhost:3000

# 4. CẤU HÌNH GỬI EMAIL THÔNG BÁO / QUÊN MẬT KHẨU (NODEMAILER)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="CareMatch Vietnam" <no-reply@carematch.vn>
