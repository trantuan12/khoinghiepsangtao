# ========================================================
# MẪU CẤU HÌNH MÔI TRƯỜNG CHO HỆ THỐNG CARE MATCH (.env.example)
# Khi triển khai lên Cloud / VPS: Copy file này thành .env và điền thông số thật
# ========================================================

# 1. CỔNG CHẠY SERVER BACKEND
PORT=5000
NODE_ENV=production

# 2. CẤU HÌNH KẾT NỐI MYSQL DATABASE
# Local (XAMPP):
#   DB_HOST=localhost | DB_USER=root | DB_PASSWORD= | DB_NAME=care_match_db | DB_PORT=3306
# Railway:
#   Lấy từ Railway MySQL service → tab Variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=care_match_db
DB_PORT=3306

# 3. ĐỊA CHỈ TRANG WEB FRONTEND ĐƯỢC PHÉP TRUY CẬP (CORS)
# Local: http://localhost:3000
# Vercel: https://ten-app.vercel.app
CLIENT_URL=http://localhost:3000

# 4. CẤU HÌNH GỬI EMAIL THÔNG BÁO / QUÊN MẬT KHẨU (NODEMAILER)
# Sử dụng tài khoản Gmail:
# 1. Bật xác minh 2 bước trong Google Account
# 2. Tạo 'Mật khẩu ứng dụng' (App Password) tại https://myaccount.google.com/apppasswords
# 3. Điền email và mật khẩu ứng dụng (16 chữ số) vào bên dưới:
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="CareMatch Vietnam" <no-reply@carematch.vn>

# Tuỳ chọn: Cấu hình SMTP máy chủ riêng (nếu không dùng Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
